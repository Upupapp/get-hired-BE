# =============================================================================
# GetHired BE — environment variable reference
# =============================================================================
# Copy this file to .env for local development.
# NEVER commit .env or any real secret to git.
# Secrets belong in your deployment environment (Linode env vars, GitHub
# Secrets, a secrets manager) — not in this file or any file tracked by git.
# =============================================================================

# ---------------------------------------------------------------------------
# Firebase Admin credentials
# Choose ONE of the four strategies below. Base64 is preferred for Linode/CI.
# ---------------------------------------------------------------------------

# Strategy 1 (preferred for Linode/CI): base64-encode your service account JSON
# then set this variable. Generate with:
#   base64 -w 0 path/to/serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Strategy 2: paste the JSON directly as a single-line string
FIREBASE_SERVICE_ACCOUNT_JSON=

# Strategy 3: Application Default Credentials (GCP-managed environments only)
GOOGLE_APPLICATION_CREDENTIALS=

# Strategy 4: local dev only — path to your local service account JSON file
# This is BLOCKED in production (NODE_ENV=production).
FIREBASE_SERVICE_ACCOUNT_PATH=

# ---------------------------------------------------------------------------
# Firebase client-side config (safe to be non-secret — used in web SDK)
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
API_KEY=
AUTH_DOMAIN=
PROJECT_ID=
STORAGE_BUCKET=
SENDER_ID=
APP_ID=
MEASUREMENT_ID=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DB_USER=
DB_HOST=
DB_DATABASE=
DB_PASSWORD=
DB_PORT=5432
SCHEMA=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
SECRET=
APP_URL=http://localhost:4200
BUCKET_URL=
PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Email (SendGrid)
# ---------------------------------------------------------------------------
MAILER_KEY=
MAILER_SENDER=
MAILER_TEMPLATE=

# ---------------------------------------------------------------------------
# Payments (PayMongo)
# ---------------------------------------------------------------------------
PAYMONGO_SK=
PAYMONGO_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Project selector (for multi-project local dev)
# ---------------------------------------------------------------------------
PROJECT_NAME=
is_staging=false

# ---------------------------------------------------------------------------
# Google Indexing API
# DISABLED BY DEFAULT — do not enable until:
#   1. Search Console property is verified for https://gethiredonline.app
#   2. A GCP service account is created with "Owner" role in Search Console
#   3. The Indexing API is enabled in the GCP project
#   4. The service account key is generated and stored securely
# See: SEO_GOOGLE_INDEXING_API_RUNBOOK.md for full setup steps.
# ---------------------------------------------------------------------------
GOOGLE_INDEXING_API_ENABLED=false
# Preferred: base64-encoded service account JSON
# Generate with:  base64 -w 0 path/to/service-account.json
GOOGLE_INDEXING_SERVICE_ACCOUNT_BASE64=
# Alternative: individual key fields (used if BASE64 is empty)
GOOGLE_INDEXING_CLIENT_EMAIL=
GOOGLE_INDEXING_PRIVATE_KEY=
PUBLIC_SITE_URL=https://gethiredonline.app

# ---------------------------------------------------------------------------
# reCAPTCHA (signup bot protection)
# Without this set, helpers/recaptcha.js fails OPEN -- signup works exactly
# as it does today, with zero verification. Get the matching SECRET key
# (not the public SITE key already used by the frontend) from
# https://www.google.com/recaptcha/admin for the same site/key pair the
# frontend's environment.ts `recaptchaSiteKey` belongs to.
# ---------------------------------------------------------------------------
RECAPTCHA_SECRET_KEY=
